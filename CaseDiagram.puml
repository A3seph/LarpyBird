@startuml
left to right direction

actor "Player" as Player

rectangle "Larpy Birb System" {
    usecase "Navigate Main Menu" as UC_Menu
    usecase "Configure Settings" as UC_Settings
    usecase "Select Bird Skin" as UC_Skin
    usecase "Toggle Audio" as UC_Audio
    usecase "View About Page" as UC_About
    usecase "Preview Author Profile" as UC_Author
    usecase "Play Game" as UC_Play
    usecase "Control Bird (Jump)" as UC_Jump
    usecase "Pause / Resume Game" as UC_Pause
    usecase "View High Score" as UC_Score
    usecase "Restart Game" as UC_Restart
}

Player --> UC_Menu
Player --> UC_Settings
Player --> UC_About
Player --> UC_Play

UC_Settings <.. UC_Skin : <<include>>
UC_Settings <.. UC_Audio : <<include>>

UC_About <.. UC_Author : <<extend>>

UC_Play <.. UC_Jump : <<include>>
UC_Play <.. UC_Pause : <<extend>>
UC_Play <.. UC_Score : <<include>>
UC_Play <.. UC_Restart : <<extend>>
@enduml